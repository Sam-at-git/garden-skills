# VoxCPM provider configuration.
#
# Copy this file to voxcpm.env (same directory) and fill in your paths.
# The voxcpm.sh provider sources voxcpm.env automatically, so you only set
# these once instead of exporting them in every shell.
#
#   cp voxcpm.env.example voxcpm.env
#   $EDITOR voxcpm.env

# REQUIRED — absolute path to your local VoxCPM2 snapshot (the 4.6G model is
# NOT bundled with the skill). Download once:
#   snapshot_download("OpenBMB/VoxCPM2", local_dir="./pretrained_models/VoxCPM2")
export VOXCPM_MODEL_PATH="/Users/samzhou/.cache/huggingface/hub/VoxCPM2"

# Python interpreter that has voxcpm + torch installed.
# On macOS with conda, point this at your env, e.g.:
#   /Users/you/miniconda3/envs/cc/bin/python
export VOXCPM_PYTHON="python3"

# Voice cloning — absolute path to a reference wav (any short clean clip of
# the target voice). The skill ships Sam's at references/voices/sam_voice_ref.wav.
# Set this to that path (or to your own voice sample) to clone.
export VOXCPM_VOICE="/Users/samzhou/.cache/huggingface/hub/VoxCPM2/sam_voice_ref.wav"

# OPTIONAL — device, port, generation params
# export VOXCPM_DEVICE="auto"     # auto|cpu|mps|cuda   (auto picks mps on Mac)
# export VOXCPM_PORT="8765"
# export VOXCPM_CFG="2.0"         # CFG guidance scale
# export VOXCPM_STEPS="10"        # inference timesteps

# OPTIONAL — instead of cloning from VOXCPM_VOICE, design a voice from a
# natural-language description (leave VOXCPM_VOICE empty to use this):
# export VOXCPM_VOICE_DESIGN="A young woman, gentle and sweet voice"
